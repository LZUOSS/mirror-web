{
"options": {{ site.data.options | jsonify }},
"helps": [
  {%- for help in site.help -%}
    {"mirrorid": {{ help.zconf.mirrorid | default: help.zconf.name | jsonify }}, "url": {{ help.url | jsonify }}}
    {%- for mirrorid in help.zconf.mirror_aliases -%}
      ,{"mirrorid": {{ mirrorid | jsonify }}, "url": {{ help.url | jsonify }}}
    {%- endfor -%}
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
}
